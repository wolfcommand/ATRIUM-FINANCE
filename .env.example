# Wolf local / Cloud Run env template — no secrets in repo.
# Production: use Secret Manager → inject these names into Cloud Run.

# --- Database (production target = Cloud SQL Postgres) ---
# Local smoke may omit this and use SQLite at WOLF_DB_PATH (dev-only).
DATABASE_URL=postgres://wolf:wolf@127.0.0.1:5432/wolf
WOLF_DB_DRIVER=sqlite
# WOLF_DB_DRIVER=postgres
WOLF_DB_PATH=./apps/api/data/wolf.sqlite

# --- Service URLs ---
WOLF_API_ORIGIN=http://127.0.0.1:4000
WOLF_JWKS_URL=http://127.0.0.1:4000/.well-known/jwks.json
NEXT_PUBLIC_FINANCE_URL=http://localhost:3000
NEXT_PUBLIC_HR_URL=http://localhost:3200
WOLF_CORS_ORIGIN=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3200,http://127.0.0.1:3200

# Ports
PORT_API=4000
PORT_PORTAL=3100
PORT_FINANCE=3000
PORT_HR=3200

# --- Secrets (Secret Manager names only; values never committed) ---
# WOLF_SESSION_SIGNING_KEY
# DATABASE_URL
# MAIL_WEBHOOK_URL
# PAYSLIP_FROM=hris-noreply@your-domain

# --- Optional mail ---
# MAIL_WEBHOOK_URL=https://mail-bridge.example/send
# SMTP_URL=  # prefer MAIL_WEBHOOK_URL HTTP bridge on Cloud Run

# Event inject (disable in prod)
WOLF_ALLOW_EVENT_INJECT=true
